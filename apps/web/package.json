{
  "name": "web",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "pnpm typegen:hono && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "pnpm typegen:hono && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "deploy": "vite build && wrangler deploy",
    "typegen:cf": "wrangler types",
    "typegen:hono": "pnpm --filter api typegen:hono"
  },
  "dependencies": {
    "@formisch/svelte": "^1.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-auth": "^1.6.29",
    "hono": "catalog:",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@internationalized/date": "^3.12.3",
    "@lucide/svelte": "^1.34.0",
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "api": "workspace:*",
    "bits-ui": "^2.19.0",
    "clsx": "^2.1.1",
    "dto": "workspace:*",
    "shadcn-svelte": "^1.5.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "wrangler": "catalog:"
  }
}
