{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boilerplate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "boilerplate.cardtunic.cc/api/*",
      "zone_name": "cardtunic.cc",
    },
  ],
  "hyperdrive": [
    {
      "id": "b4477b0d2d1a4a97a007603bf242d01f",
      "binding": "HYPERDRIVE",
      "localConnectionString": "postgresql://postgres:root@localhost:5432/postgres",
    },
  ],
}
