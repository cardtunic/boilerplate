{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "boilerplate-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": false,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "routes": [
    {
      "pattern": "boilerplate.cardtunic.cc/api/*",
      "zone_name": "cardtunic.cc",
    },
  ],
}
