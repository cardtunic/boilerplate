{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import"],
  "ignorePatterns": ["**/worker-configuration.d.ts", "**/dist-types/**"],
  "rules": {
    "eqeqeq": "error",
    "no-debugger": "error",
    "no-var": "error",
    "prefer-const": "error",
    "typescript/consistent-type-imports": "error"
  }
}
